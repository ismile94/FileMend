# Frontend Environment Variables
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# .env.local git'e commit edilmez.

# PDF to Word API URL (Hugging Face Space veya lokal backend)
# Lokal backend: http://localhost:10000
# HF Space örnek: https://ihmuin-filemend-com.hf.space
VITE_API_URL=https://ihmuin-filemend-com.hf.space

# Alternatif (öncelik VITE_API_URL'dan düşük)
# VITE_BACKEND_URL=http://localhost:10000

# PDF Compress API URL (ayrı backend - Hugging Face Spaces veya lokal)
# Lokal backend: http://localhost:7860
# HF Space örnek: https://YOUR-USERNAME-pdf-compress-api.hf.space
VITE_PDF_COMPRESS_API_URL=http://localhost:7860
